# Schwab keys — same template as SCHWAB-KEYS.txt
# On install/launch, Paper Trader copies this to .env if .env is missing.
# Paste App Key and App Secret into Documents\Paper Trader\.env
# Never commit .env. Tokens after Connect go in schwab_tokens.json (gitignored).

SCHWAB_APP_KEY=paste-app-key-here
SCHWAB_APP_SECRET=paste-app-secret-here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_APP_NAME=personal-market-data
