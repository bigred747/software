# Schwab Developer Portal app credentials (Market Data).
# Copy this file to .env in the Paper Trader install folder and paste App Key / App Secret when approved.
# Never commit .env. Live trading stays locked; these values are for future market-data use only.
# OAuth access/refresh tokens are not set here — they come later after a separate authorize step.

SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_APP_NAME=personal-market-data
